# LogiDoc-RAG environment settings: names and safe defaults only, no secrets.
#
# The application reads these from the process environment; it does not load
# this file. Set the ones you need in the shell before starting it, e.g. in
# PowerShell:   $env:LOGIDOC_AUTH_MODE = "required"
# Every setting is optional; the value shown is the default.

# Production: start from deploy/logidoc.production.env.example instead; there
# every setting marked (production: required) must be set, and the server
# refuses to start while an example value is left in place.

# --- Server (python src/api/serve.py) ---------------------------------------
# LOGIDOC_ENV=development             # development | test | production (src/environment.py)
# LOGIDOC_API_HOST=127.0.0.1          # local mode only starts on a loopback address
# LOGIDOC_API_PORT=8000
# LOGIDOC_AUTH_MODE=local             # local (no sign-in) | required (accounts: scripts/manage_users.py) (production: required)
# LOGIDOC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # exact origins; * is refused (production: required, HTTPS)
# LOGIDOC_TRUSTED_HOSTS=              # host names answered, e.g. logidoc.your-company.com; empty: any (production: required)
# LOGIDOC_COOKIE_SECURE=              # 1 behind HTTPS (always on in production)
# LOGIDOC_FRONTEND_DIR=frontend/dist  # the React build served at /
# LOGIDOC_FORWARDED_ALLOW_IPS=127.0.0.1   # the reverse proxy whose X-Forwarded-* headers are trusted
# LOGIDOC_HTTPS_REDIRECT=0            # 1: plain HTTP is redirected to HTTPS (the proxy usually does it)
# LOGIDOC_HSTS_SECONDS=0              # Strict-Transport-Security on HTTPS responses (production default: 31536000)
# LOGIDOC_MAX_REQUEST_KB=1024         # largest JSON or other request body
# LOGIDOC_MAX_UPLOAD_FILES=20         # files in one upload (each at most LOGIDOC_MAX_UPLOAD_MB)
# LOGIDOC_BACKGROUND_JOBS=1           # 0: no backup schedule and no monitor in this server

# --- Logs ---------------------------------------------------------------------
# LOGIDOC_LOG_FORMAT=text             # text | json (production default: json)
# LOGIDOC_LOG_LEVEL=INFO
# LOGIDOC_LOG_FILE=                   # also write to this file (rotated at 10 MB, 5 kept)

# --- Backups (scripts/manage_backups.py; docs/AUTOMATED_BACKUP_OPERATIONS.md) -------
# LOGIDOC_BACKUP_DIR=backups          # another disk than the data in production (production: required)
# LOGIDOC_BACKUP_SCHEDULE=off         # off | daily@HH:MM (UTC) | every:<N>h (production: required)
# LOGIDOC_BACKUP_KEEP_DAILY=7         # retention of scheduled backups (manual ones are never removed)
# LOGIDOC_BACKUP_KEEP_WEEKLY=4
# LOGIDOC_BACKUP_KEEP_MONTHLY=6
# LOGIDOC_BACKUP_MIN_FREE_MB=1024     # free space left after a backup, or it does not start
# LOGIDOC_BACKUP_RETRY_MINUTES=60     # a failed scheduled backup is tried again after this

# --- Monitoring and alerts (docs/OBSERVABILITY_AND_MONITORING.md) -----------
# LOGIDOC_MONITOR_INTERVAL=300        # seconds between the monitor's checks
# LOGIDOC_ALERT_WEBHOOK_URL=          # HTTPS URL that receives alerts as JSON (a secret: never logged)
# LOGIDOC_ALERT_DISK_WARNING_MB=2048
# LOGIDOC_ALERT_DISK_CRITICAL_MB=512
# LOGIDOC_ALERT_WINDOW_SECONDS=300
# LOGIDOC_ALERT_5XX_COUNT=5
# LOGIDOC_ALERT_DB_ERROR_COUNT=1
# LOGIDOC_ALERT_LATENCY_MS=5000       # 95th percentile, with at least LOGIDOC_ALERT_MIN_REQUESTS requests
# LOGIDOC_ALERT_MIN_REQUESTS=20
# LOGIDOC_ALERT_OLLAMA_FAILURES=3     # failed model-service checks in a row
# LOGIDOC_ALERT_BACKUP_MAX_AGE_HOURS=26
# LOGIDOC_ALERT_COOLDOWN_SECONDS=3600

# --- Where the data lives ----------------------------------------------------
# LOGIDOC_DATA_DIR=data               # documents (raw/), databases, archive, quarantine
# LOGIDOC_CHROMA_DIR=chroma_db        # the vector index
# Single databases can be moved one by one (each wins over LOGIDOC_DATA_DIR):
# LOGIDOC_REVIEW_DB=data/audit_reviews.sqlite3
# LOGIDOC_HISTORY_DB=data/audit_history.sqlite3
# LOGIDOC_AUTH_DB=data/auth.sqlite3   # password hashes: keep it private and backed up
# LOGIDOC_INGESTION_DB=data/ingestion_register.sqlite3
# LOGIDOC_EXTRACTION_DB=data/extractions.sqlite3
# LOGIDOC_CARRIER_DB=data/carrier_registry.sqlite3
# (A restore can only replace live data in one step when every store keeps its default place in LOGIDOC_DATA_DIR.)

# --- Ingestion and review policy ---------------------------------------------
# LOGIDOC_MAX_UPLOAD_MB=25            # per PDF
# LOGIDOC_REQUIRE_APPROVAL=           # 1: resolutions and dismissals wait for an administrator
# LOGIDOC_MIN_NOTE_LENGTH=10
# LOGIDOC_FREIGHT_TOLERANCES=         # freight audit tolerances as JSON, e.g. {"fuel_surcharge": {"absolute": 5}}; empty: exact matching

# --- Ollama --------------------------------------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434  # read by the ollama library
# LOGIDOC_OLLAMA_CONNECT_TIMEOUT=5    # seconds
# LOGIDOC_EMBED_TIMEOUT=60            # seconds for one embedding
# LOGIDOC_LLM_TIMEOUT=120             # seconds for one generated answer
# Models are set in config.py: EMBEDDING_MODEL=nomic-embed-text, LLM_MODEL=nemotron-3-nano:4b

# --- Frontend development server (npm run dev) --------------------------------
# LOGIDOC_API_URL=http://127.0.0.1:8000   # where Vite proxies /api
