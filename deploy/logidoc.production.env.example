# LogiDoc-RAG production settings: copy to /etc/logidoc/logidoc.env (chmod 640),
# then replace every example value. The server refuses to start while a value
# from this file is left unchanged (example.com, change-me, <...>).
# No secret belongs in the repository: this file holds placeholders only.

LOGIDOC_ENV=production
LOGIDOC_AUTH_MODE=required

# Behind the HTTPS reverse proxy on the same machine
LOGIDOC_API_HOST=127.0.0.1
LOGIDOC_API_PORT=8000
LOGIDOC_FORWARDED_ALLOW_IPS=127.0.0.1
LOGIDOC_TRUSTED_HOSTS=logidoc.example.com
LOGIDOC_CORS_ORIGINS=https://logidoc.example.com
# The proxy redirects HTTP itself; 1 adds the same redirect in the application
LOGIDOC_HTTPS_REDIRECT=0
LOGIDOC_HSTS_SECONDS=31536000

# Absolute folders; backups on another disk than the data
LOGIDOC_DATA_DIR=/var/lib/logidoc/data
LOGIDOC_CHROMA_DIR=/var/lib/logidoc/chroma_db
LOGIDOC_BACKUP_DIR=/var/backups/logidoc

# Backups: daily at 02:30 UTC; keep 7 daily, 4 weekly, 6 monthly
LOGIDOC_BACKUP_SCHEDULE=daily@02:30
LOGIDOC_BACKUP_KEEP_DAILY=7
LOGIDOC_BACKUP_KEEP_WEEKLY=4
LOGIDOC_BACKUP_KEEP_MONTHLY=6
LOGIDOC_BACKUP_MIN_FREE_MB=1024

# Logs (JSON lines to the journal; a rotating file as well if set)
LOGIDOC_LOG_FORMAT=json
LOGIDOC_LOG_LEVEL=INFO
LOGIDOC_LOG_FILE=/var/log/logidoc/api.log

# Alerts: to the log always; to a webhook (HTTPS) when set. The URL is a secret.
# LOGIDOC_ALERT_WEBHOOK_URL=https://<your alert receiver>
LOGIDOC_ALERT_DISK_WARNING_MB=2048
LOGIDOC_ALERT_DISK_CRITICAL_MB=512
